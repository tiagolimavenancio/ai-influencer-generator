# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Luma AI Configuration
NEXT_PUBLIC_LUMA_AGENTS_API_KEY=your_luma_agents_api_key

# Environment Mode
# Set to "true" for testing with mock images (no real Luma API calls)
# Set to "false" or remove for production (real Luma API generation)
NEXT_PUBLIC_LUMA_MOCK=false

# Zernio API Configuration
# Get your API key from https://zernio.com/settings/api-keys
ZERNIO_API_KEY=sk_your_zernio_api_key_here

# Stripe Configuration
# Get your keys from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Supabase Service Role Key (for admin operations like webhooks)
# Get from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
